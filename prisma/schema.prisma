// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "sqlserver"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Role {
  id    String @id @default(uuid())
  name  String @unique
  users User[]
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  roleId    String?
  role      Role?      @relation(fields: [roleId], references: [id])
  favorites Favorite[]
}

model Movie {
  id          String   @id @default(uuid())
  title       String
  description String?
  releaseDate DateTime
  posterUrl   String?
  movieType   String // Dùng String thay vì Enum
  createdAt   DateTime @default(now())

  episodes  Episode[]
  genres    MovieGenre[]
  favorites Favorite[] // Thêm mối quan hệ ngược
}

model Episode {
  id        String   @id @default(uuid())
  title     String
  number    Int
  videoUrl  String
  movieId   String
  createdAt DateTime @default(now())

  movie Movie @relation(fields: [movieId], references: [id])
}

model Genre {
  id   String @id @default(uuid())
  name String @unique

  movies MovieGenre[]
  mangas MangaGenre[]
}

model MovieGenre {
  movieId String
  genreId String

  movie Movie @relation(fields: [movieId], references: [id])
  genre Genre @relation(fields: [genreId], references: [id])

  @@id([movieId, genreId])
}

model Manga {
  id          String   @id @default(uuid())
  title       String
  author      String?
  description String?
  coverUrl    String?
  createdAt   DateTime @default(now())

  chapters  Chapter[]
  genres    MangaGenre[]
  favorites Favorite[] // Thêm mối quan hệ ngược
}

model MangaGenre {
  mangaId String
  genreId String

  manga Manga @relation(fields: [mangaId], references: [id])
  genre Genre @relation(fields: [genreId], references: [id])

  @@id([mangaId, genreId])
}

model Chapter {
  id        String   @id @default(uuid())
  title     String
  number    Int
  mangaId   String
  createdAt DateTime @default(now())

  manga  Manga   @relation(fields: [mangaId], references: [id])
  images Image[]
}

model Image {
  id         String   @id @default(uuid())
  chapterId  String
  imageUrl   String
  pageNumber Int
  createdAt  DateTime @default(now())

  chapter Chapter @relation(fields: [chapterId], references: [id])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  movieId   String?
  mangaId   String?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  movie Movie? @relation(fields: [movieId], references: [id])
  manga Manga? @relation(fields: [mangaId], references: [id])
}
