// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement()) // Khóa chính tự tăng
  name      String
  email     String   @unique // Email phải là duy nhất
  posts     Post[]   // Quan hệ 1-n với bảng Post
  createdAt DateTime @default(now())
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id]) // Quan hệ n-1 với User
  authorId  Int
  createdAt DateTime @default(now())
}