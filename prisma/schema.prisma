generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model Permission {
  PermissionId Int      @id @default(autoincrement())
  code         String   @unique
  description  String?
  createdAt    DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  RoleId       Int
  PermissionId Int

  role       Role       @relation(fields: [RoleId], references: [RoleId])
  permission Permission @relation(fields: [PermissionId], references: [PermissionId])

  @@id([RoleId, PermissionId])
}

model Role {
  RoleId    Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]
}

model UserRole {
  UserId Int
  RoleId Int

  user User @relation(fields: [UserId], references: [UserId])
  role Role @relation(fields: [RoleId], references: [RoleId])

  @@id([UserId, RoleId])
}

model RefreshToken {
  RefreshTokenId Int      @id @default(autoincrement())
  token          String   @unique
  UserId         Int
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user User @relation(fields: [UserId], references: [UserId])

  @@index([UserId])
}

model User {
  UserId   Int    @id @default(autoincrement())
  username String @unique
  email    String @unique
  password String @db.VarChar(Max)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Global roles
  roles UserRole[]

  // Team membership
  teamMembers TeamMember[]

  refreshTokens RefreshToken[]
  resetToken    String?        @db.VarChar(255)
  resetExpire   DateTime?

  favorites Favorite[]
}

model Team {
  TeamId    Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  members TeamMember[]
}

model TeamRole {
  TeamRoleId Int    @id @default(autoincrement())
  name       String

  members     TeamMember[]
  permissions TeamRolePermission[]
}

model TeamMember {
  TeamMemberId Int @id @default(autoincrement())

  TeamId     Int
  UserId     Int
  TeamRoleId Int

  team     Team     @relation(fields: [TeamId], references: [TeamId])
  user     User     @relation(fields: [UserId], references: [UserId])
  teamRole TeamRole @relation(fields: [TeamRoleId], references: [TeamRoleId])

  @@unique([TeamId, UserId, TeamRoleId])
  @@index([UserId])
  @@index([TeamId])
}

model TeamPermission {
  TeamPermissionId Int     @id @default(autoincrement())
  code             String  @unique
  description      String?

  roles TeamRolePermission[]
}

model TeamRolePermission {
  TeamRoleId       Int
  TeamPermissionId Int

  role       TeamRole       @relation(fields: [TeamRoleId], references: [TeamRoleId])
  permission TeamPermission @relation(fields: [TeamPermissionId], references: [TeamPermissionId])

  @@id([TeamRoleId, TeamPermissionId])
}

model Movie {
  MovieId     Int          @id @default(autoincrement())
  title       String
  description String?
  releaseDate DateTime
  posterUrl   String?
  movieType   String
  createdAt   DateTime     @default(now())
  episodes    Episode[]
  favorites   Favorite[]
  genres      MovieGenre[]
}

model Episode {
  EpisodeId Int      @id @default(autoincrement())
  title     String
  number    Int
  videoUrl  String
  MovieId   Int
  createdAt DateTime @default(now())
  movie     Movie    @relation(fields: [MovieId], references: [MovieId])
}

model Genre {
  GenreId Int          @id @default(autoincrement())
  name    String       @unique
  mangas  MangaGenre[]
  movies  MovieGenre[]
}

model MovieGenre {
  MovieId Int
  GenreId Int
  genre   Genre @relation(fields: [GenreId], references: [GenreId])
  movie   Movie @relation(fields: [MovieId], references: [MovieId])

  @@id([MovieId, GenreId])
}

model Manga {
  MangaId     Int          @id @default(autoincrement())
  title       String
  author      String?
  description String?
  coverUrl    String?
  createdAt   DateTime     @default(now())
  chapters    Chapter[]
  favorites   Favorite[]
  genres      MangaGenre[]
}

model MangaGenre {
  MangaId Int
  GenreId Int
  genre   Genre @relation(fields: [GenreId], references: [GenreId])
  manga   Manga @relation(fields: [MangaId], references: [MangaId])

  @@id([MangaId, GenreId])
}

model Chapter {
  ChapterId Int      @id @default(autoincrement())
  title     String
  number    Int
  MangaId   Int
  createdAt DateTime @default(now())
  manga     Manga    @relation(fields: [MangaId], references: [MangaId])
  images    Image[]
}

model Image {
  ImageId    Int      @id @default(autoincrement())
  ChapterId  Int
  imageUrl   String
  pageNumber Int
  createdAt  DateTime @default(now())
  chapter    Chapter  @relation(fields: [ChapterId], references: [ChapterId])
}

model Favorite {
  FavoriteId Int      @id @default(autoincrement())
  UserId     Int
  MovieId    Int?
  MangaId    Int?
  createdAt  DateTime @default(now())
  manga      Manga?   @relation(fields: [MangaId], references: [MangaId])
  movie      Movie?   @relation(fields: [MovieId], references: [MovieId])
  user       User     @relation(fields: [UserId], references: [UserId])
}
