generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model Role {
  RoleId        Int      @id @default(autoincrement())
  name          String   @unique
  createdAt     DateTime @default(now())
  createdUserId Int?
  updatedAt     DateTime @default(now())
  updatedUserId Int?
  users         User[]
}

model User {
  UserId        Int          @id @default(autoincrement())
  username      String       @unique
  email         String       @unique
  password      String       @db.VarChar(Max)
  createdAt     DateTime     @default(now())
  createdUserId Int?
  updatedAt     DateTime     @default(now())
  updatedUserId Int?
  RoleId        Int?
  favorites     Favorite[]
  TeamDetail    TeamDetail[]
  role          Role?        @relation(fields: [RoleId], references: [RoleId])
}

model Team {
  TeamId        Int          @id @default(autoincrement())
  name          String       @unique
  createdAt     DateTime     @default(now())
  createdUserId Int?
  updatedAt     DateTime     @default(now())
  updatedUserId Int?
  TeamDetail    TeamDetail[]
}

model TeamDetail {
  TeamDetailId  Int      @id @default(autoincrement())
  TeamId        Int
  UserId        Int
  createdAt     DateTime @default(now())
  createdUserId Int?
  updatedAt     DateTime @default(now())
  updatedUserId Int?
  team          Team     @relation(fields: [TeamId], references: [TeamId])
  user          User     @relation(fields: [UserId], references: [UserId])
}

model Movie {
  MovieId     Int          @id @default(autoincrement())
  title       String
  description String?
  releaseDate DateTime
  posterUrl   String?
  movieType   String
  createdAt   DateTime     @default(now())
  episodes    Episode[]
  favorites   Favorite[]
  genres      MovieGenre[]
}

model Episode {
  EpisodeId Int      @id @default(autoincrement())
  title     String
  number    Int
  videoUrl  String
  MovieId   Int
  createdAt DateTime @default(now())
  movie     Movie    @relation(fields: [MovieId], references: [MovieId])
}

model Genre {
  GenreId Int          @id @default(autoincrement())
  name    String       @unique
  mangas  MangaGenre[]
  movies  MovieGenre[]
}

model MovieGenre {
  MovieId Int
  GenreId Int
  genre   Genre @relation(fields: [GenreId], references: [GenreId])
  movie   Movie @relation(fields: [MovieId], references: [MovieId])

  @@id([MovieId, GenreId])
}

model Manga {
  MangaId     Int          @id @default(autoincrement())
  title       String
  author      String?
  description String?
  coverUrl    String?
  createdAt   DateTime     @default(now())
  chapters    Chapter[]
  favorites   Favorite[]
  genres      MangaGenre[]
}

model MangaGenre {
  MangaId Int
  GenreId Int
  genre   Genre @relation(fields: [GenreId], references: [GenreId])
  manga   Manga @relation(fields: [MangaId], references: [MangaId])

  @@id([MangaId, GenreId])
}

model Chapter {
  ChapterId Int      @id @default(autoincrement())
  title     String
  number    Int
  MangaId   Int
  createdAt DateTime @default(now())
  manga     Manga    @relation(fields: [MangaId], references: [MangaId])
  images    Image[]
}

model Image {
  ImageId    Int      @id @default(autoincrement())
  ChapterId  Int
  imageUrl   String
  pageNumber Int
  createdAt  DateTime @default(now())
  chapter    Chapter  @relation(fields: [ChapterId], references: [ChapterId])
}

model Favorite {
  FavoriteId Int      @id @default(autoincrement())
  UserId     Int
  MovieId    Int?
  MangaId    Int?
  createdAt  DateTime @default(now())
  manga      Manga?   @relation(fields: [MangaId], references: [MangaId])
  movie      Movie?   @relation(fields: [MovieId], references: [MovieId])
  user       User     @relation(fields: [UserId], references: [UserId])
}
